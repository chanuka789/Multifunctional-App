# --- Required for accounts and share links (tools work without any of these) ---
# Railway: reference your Postgres service, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:pass@localhost:5432/ondevo

# Railway Bucket credentials (reference them from the bucket: ${{Bucket.BUCKET}} etc.)
BUCKET=
ENDPOINT=https://t3.storageapi.dev
REGION=auto
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
# Only for older buckets that need path-style URLs (the bucket's Credentials tab says so)
S3_PATH_STYLE=false

# --- Optional ---
NODE_ENV=production
# Public site address. On Railway this is filled from RAILWAY_PUBLIC_DOMAIN automatically.
PUBLIC_ORIGIN=
# Minutes before a shared file is deleted (default 120 = 2 hours)
SHARE_TTL_MINUTES=120
# Largest file a share link takes, in MB
GUEST_MAX_MB=50
USER_MAX_MB=200
# How often the cleanup job runs, in seconds
CLEANUP_EVERY_SECONDS=300
# Random text used to hash visitor IPs for rate limits
IP_SALT=change-me
